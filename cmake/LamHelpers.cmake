# Build helpers shared by every module, test, example and game.
#
#   lam_add_module(NAME <m> [TARGET <t>] SOURCES <cpp...> DEPS <targets...>)
#   lam_add_backend(NAME <m> [TARGET <t>] SOURCES <cpp...> DEPS <targets...>)
#   lam_add_test(MODULE <m> [NAME <exe>] SOURCES <cpp...> DEPS <targets...> [LABELS gpu|bench])
#   lam_add_example(NAME <exe> SOURCES <cpp...> DEPS <targets...> [ASSETS <dir>])
#   lam_add_game(NAME <exe> SOURCES <cpp...> [DEPS <targets...>] [ASSETS <dir>]
#                [SIM_LIBRARY <name> SIM_SOURCES <cpp...> SIM_DEPS <targets...>])

option(LAM_PCH "Precompiled headers on module targets" ON)

# Drop repeated static libraries from link lines. Apple ld warns about duplicates when a test's
# DEPS also come in through lam_test_support.
if(POLICY CMP0156)
  cmake_policy(SET CMP0156 NEW)
endif()

include(CheckIPOSupported)
check_ipo_supported(RESULT LAM_IPO_SUPPORTED OUTPUT LAM_IPO_MESSAGE LANGUAGES CXX)

# Warnings, floating-point determinism, sanitizers and LTO for one target.
function(lam_target_defaults target)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wshadow -Wconversion -Wno-sign-conversion
                                           -ffp-contract=off)
  if(LAM_WERROR)
    target_compile_options(${target} PRIVATE -Werror)
  endif()
  if(LAM_SANITIZE)
    target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${target} PRIVATE -fsanitize=address,undefined)
  endif()
  if(LAM_LTO AND LAM_IPO_SUPPORTED)
    set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
  endif()
endfunction()

function(lam_add_module)
  cmake_parse_arguments(A "" "NAME;TARGET" "SOURCES;DEPS" ${ARGN})
  set(t lam_${A_NAME})
  if(A_TARGET)
    set(t ${A_TARGET})
  endif()
  add_library(${t} STATIC ${A_SOURCES})
  target_include_directories(${t} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
  target_compile_features(${t} PUBLIC cxx_std_20)
  if(A_DEPS)
    target_link_libraries(${t} PUBLIC ${A_DEPS})
  endif()
  lam_target_defaults(${t})
  if(LAM_PCH)
    target_precompile_headers(${t} PRIVATE <vector> <string> <cstdint> <span>)
  endif()
  set(LAM_LAST_TARGET ${t} PARENT_SCOPE)
endfunction()

function(lam_add_backend)
  cmake_parse_arguments(A "" "NAME;TARGET" "SOURCES;DEPS" ${ARGN})
  set(t lam_${A_NAME}_rl)
  if(A_TARGET)
    set(t ${A_TARGET})
  endif()
  add_library(${t} STATIC ${A_SOURCES})
  if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/backend/include)
    target_include_directories(${t} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/backend/include)
  endif()
  if(TARGET lam_${A_NAME} AND NOT A_TARGET)
    target_link_libraries(${t} PUBLIC lam_${A_NAME})
  endif()
  if(A_DEPS)
    target_link_libraries(${t} PUBLIC ${A_DEPS})
  endif()
  target_link_libraries(${t} PRIVATE lam_rl_common raylib)
  lam_target_defaults(${t})
  set(LAM_LAST_TARGET ${t} PARENT_SCOPE)
endfunction()

function(lam_add_test)
  cmake_parse_arguments(A "" "MODULE;NAME" "SOURCES;DEPS;LABELS" ${ARGN})
  set(t lam_${A_MODULE}_tests)
  if(A_NAME)
    set(t ${A_NAME})
  endif()
  add_executable(${t} ${A_SOURCES})
  target_link_libraries(${t} PRIVATE lam_test_support ${A_DEPS})
  if(NOT LAM_SANITIZE)
    target_link_libraries(${t} PRIVATE lam_alloc_hook)
  endif()
  lam_target_defaults(${t})
  set(labels ${A_MODULE})
  if(A_LABELS)
    list(APPEND labels ${A_LABELS})
  endif()
  add_test(NAME ${t} COMMAND ${t} WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
  set_tests_properties(${t} PROPERTIES LABELS "${labels}"
                       ENVIRONMENT "LAM_TEST_SOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()

# Copies an asset folder next to the executable, file by file. Also writes <exe>.assetroot with
# the source folder (empty in Release), so dev builds read assets straight from the sources.
function(lam_copy_assets target assets_dir)
  get_filename_component(src "${assets_dir}" ABSOLUTE BASE_DIR ${CMAKE_CURRENT_SOURCE_DIR})
  file(GLOB_RECURSE files CONFIGURE_DEPENDS RELATIVE ${src} ${src}/*)
  set(outputs "")
  foreach(f IN LISTS files)
    set(out ${CMAKE_CURRENT_BINARY_DIR}/assets/${f})
    add_custom_command(OUTPUT ${out}
      COMMAND ${CMAKE_COMMAND} -E copy_if_different ${src}/${f} ${out}
      DEPENDS ${src}/${f} VERBATIM)
    list(APPEND outputs ${out})
  endforeach()
  add_custom_target(${target}_assets DEPENDS ${outputs})
  add_dependencies(${target} ${target}_assets)
  file(GENERATE OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${target}.assetroot
       CONTENT "$<IF:$<CONFIG:Release>,,${src}>")
endfunction()

function(lam_add_example)
  cmake_parse_arguments(A "" "NAME;ASSETS" "SOURCES;DEPS" ${ARGN})
  add_executable(${A_NAME} ${A_SOURCES})
  target_link_libraries(${A_NAME} PRIVATE ${A_DEPS})
  lam_target_defaults(${A_NAME})
  set_target_properties(${A_NAME} PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
  if(A_ASSETS)
    lam_copy_assets(${A_NAME} ${A_ASSETS})
  endif()
endfunction()

function(lam_add_game)
  cmake_parse_arguments(A "" "NAME;ASSETS;SIM_LIBRARY" "SOURCES;DEPS;SIM_SOURCES;SIM_DEPS" ${ARGN})
  if(A_SIM_LIBRARY)
    add_library(${A_SIM_LIBRARY} STATIC ${A_SIM_SOURCES})
    target_include_directories(${A_SIM_LIBRARY} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src)
    target_link_libraries(${A_SIM_LIBRARY} PUBLIC ${A_SIM_DEPS})
    lam_target_defaults(${A_SIM_LIBRARY})
  endif()
  set(deps ${A_DEPS})
  if(NOT deps)
    set(deps lam_engine)
  endif()
  if(A_SIM_LIBRARY)
    list(APPEND deps ${A_SIM_LIBRARY})
  endif()
  set(assets_arg "")
  if(A_ASSETS)
    set(assets_arg ASSETS ${A_ASSETS})
  endif()
  lam_add_example(NAME ${A_NAME} SOURCES ${A_SOURCES} DEPS ${deps} ${assets_arg})
endfunction()
